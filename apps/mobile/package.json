{
  "name": "@sol-hair/mobile",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "expo": "~57.0.23",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "build:android": "expo export --platform android --output-dir dist/android --clear",
    "build:ios": "expo export --platform ios --output-dir dist/ios --clear",
    "build": "npm run build:android && npm run build:ios"
  },
  "private": true
}
